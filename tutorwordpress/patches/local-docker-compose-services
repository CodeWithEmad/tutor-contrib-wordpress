{%- if WORDPRESS_RUN_LOCAL %}
wordpress:
  image: {{ WORDPRESS_DOCKER_IMAGE }}
  restart: unless-stopped
  environment:
    WORDPRESS_DB_HOST: {{ WORDPRESS_MYSQL_HOST }}:{{ WORDPRESS_MYSQL_PORT }}
    WORDPRESS_DB_USER: {{ WORDPRESS_MYSQL_USERNAME }}
    WORDPRESS_DB_PASSWORD: {{ WORDPRESS_MYSQL_PASSWORD }}
    WORDPRESS_DB_NAME: {{ WORDPRESS_MYSQL_DATABASE }}
    WORDPRESS_TABLE_PREFIX: {{ WORDPRESS_TABLE_PREFIX }}
    WORDPRESS_CONFIG_EXTRA: |
      {{ WORDPRESS_CONFIG_EXTRA|replace("$", "$$")|indent(6) }}
  volumes:
    - ../../data/wordpress:/var/www/html
  {%- if RUN_MYSQL %}
  depends_on:
    - mysql
  {%- endif %}
{%- endif %}
